generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  LAWYER
  LITIGANT
  CLERK
  VENDOR
  LAW_FIRM_ADMIN
  SYSTEM_ADMIN
  SUPER_ADMIN
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  password     String
  phone        String?
  role         Role     @default(LITIGANT)
  barId        String?
  language     String   @default("en")
  subscription String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  casesAsLawyer Case[] @relation("LawyerCases")
  casesAsClient Case[] @relation("ClientCases")
  documents     Document[]
  items         MarketplaceItem[]
  sentMessages  Chat[]
  votes         Vote[]
  notifications Notification[]
  lawyerProfile LawyerProfile?
}

model LawyerProfile {
  id             Int      @id @default(autoincrement())
  userId         Int      @unique
  specialization String?
  experience     Int?
  bio            String?  @db.Text
  location       String?
  hourlyRate     Float?
  rating         Float    @default(0.0)
  reviewCount    Int      @default(0)
  
  user           User     @relation(fields: [userId], references: [id])
}

model Case {
  id              Int      @id @default(autoincrement())
  title           String
  caseNumber      String?
  court           String
  type            String
  status          String
  nextHearingDate DateTime?
  lawyerId        Int
  clientId        Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  lawyer    User       @relation("LawyerCases", fields: [lawyerId], references: [id])
  client    User?      @relation("ClientCases", fields: [clientId], references: [id])
  documents Document[]
}

model Document {
  id         Int      @id @default(autoincrement())
  fileUrl    String
  uploadedBy Int
  caseId     Int?
  createdAt  DateTime @default(now())

  uploader User  @relation(fields: [uploadedBy], references: [id])
  case     Case? @relation(fields: [caseId], references: [id])
}

model MarketplaceItem {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  price       Float
  status      String
  sellerId    Int
  createdAt   DateTime @default(now())

  seller User @relation(fields: [sellerId], references: [id])
}

model Chat {
  id        Int      @id @default(autoincrement())
  message   String
  senderId  Int
  barId     String?
  createdAt DateTime @default(now())

  sender User @relation(fields: [senderId], references: [id])
}

model Poll {
  id            Int      @id @default(autoincrement())
  question      String
  barType       String
  candidateList String[]
  endDate       DateTime
  createdAt     DateTime @default(now())

  votes Vote[]
}

model Vote {
  id     Int    @id @default(autoincrement())
  pollId Int
  userId Int
  choice String

  poll Poll @relation(fields: [pollId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([pollId, userId])
}

model Law {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  category    String
  content     String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  message   String
  isRead    Boolean  @default(false)
  type      String   @default("INFO") // INFO, MESSAGE, ALERT
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}
